    "version": "0.2.0",
    "configurations": [
        {
            "name": "ms2 run",
            "type": "python",
            "request": "launch",
            "module": "ms2.cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "run",
                "/zjbd/zd1/shechtmanlab/omer/MS2/data/020626/STAGE-13/New-06-ST14-V.czi",
                "--out",
                "/zjbd/zd1/shechtmanlab/omer/MS2/outputs/020626/STAGE-13/New-06-ST14-V",
                "--roi",
                "/zjbd/zd1/shechtmanlab/omer/MS2/outputs/020626/STAGE-13/New-06-ST14-V/New-06-ST14-V/unified/roi_selection.json"
            ]
        },
        {
            "name": "gene_expression",
            "type": "python",
            "request": "launch",
            "module": "ms2.gene_expression.run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--czi_file_path",
                "/zjbd/zd1/shechtmanlab/omer/MS2/data/020626/STAGE-13/New-06-ST14-V.czi",
                "--seg_maps_dir",
                "/zjbd/zd1/shechtmanlab/omer/MS2/outputs/020626/STAGE-13/New-06-ST14-V/New-06-ST14-V/unified/masks_split/",
                "--tracklets_path",
              "/zjbd/zd1/shechtmanlab/omer/MS2/outputs/020626/STAGE-13/New-06-ST14-V/New-06-ST14-V/unified/tracklets_unified.json",
                "--ms2_background_removed",
               "/zjbd/zd1/shechtmanlab/omer/MS2/data/020626/STAGE-13/New-06-ST14-V/C1-New-06-ST14-V_bg_removed.tif",
                "--output_dir",
                "/zjbd/zd1/shechtmanlab/omer/MS2/outputs/020626/STAGE-13/New-06-ST14-V/New-06-ST14-V/gene_expression_roi_selection",
                "--roi",
                "/zjbd/zd1/shechtmanlab/omer/MS2/outputs/020626/STAGE-13/New-06-ST14-V/New-06-ST14-V/unified/roi_selection.json"
            ]
        }
    ]
}